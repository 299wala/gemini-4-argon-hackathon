<div id="overlay"><h1>🌊 DUK DUK ULTIMATE REALISTIC 🦆</h1><p>
🦆 बत्तख <b>Realistic</b> - असली पंख, चोंच खुलती-बंद होती, खाएगी तो Fish मुंह में जाएगी!<br>
🐟 छोटी Fish + मगरमच्छ भी <b>Realistic</b> - दांत, जीभ, आंखें<br>
🌊 Water <b>Realistic</b> - लहरें, बुलबुले, रोशनी की किरणें, गहराई<br>
🐠 बड़ी Fish Realistic Aquarium - हर 3s रंग बदले
</p><button id="startBtn">Ultimate Realistic शुरू करो</button></div>
</div>
<script>
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');let W,H,dpr;
function resize(){const w=document.getElementById('gameWrap');W=w.clientWidth;H=w.clientHeight;dpr=window.devicePixelRatio||1;canvas.width=W*dpr;canvas.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);}window.addEventListener('resize',resize);resize();
let soundOn=true,audioCtx;
function initAudio(){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();}
function playDuk(b){if(!soundOn)return;initAudio();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.connect(g);g.connect(audioCtx.destination);o.type='triangle';o.frequency.setValueAtTime(b?340:620,audioCtx.currentTime);o.frequency.exponentialRampToValueAtTime(b?120:300,audioCtx.currentTime+(b?0.45:0.13));g.gain.setValueAtTime(0.35,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+(b?0.5:0.15));o.start();o.stop(audioCtx.currentTime+(b?0.5:0.15));}
function playPoint(){if(!soundOn)return;initAudio();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.connect(g);g.connect(audioCtx.destination);o.frequency.setValueAtTime(900,audioCtx.currentTime);g.gain.setValueAtTime(0.3,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.25);o.start();o.stop(audioCtx.currentTime+0.25);}
function playCroc(){if(!soundOn)return;initAudio();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.connect(g);g.connect(audioCtx.destination);o.type='sawtooth';o.frequency.setValueAtTime(80,audioCtx.currentTime);o.frequency.linearRampToValueAtTime(30,audioCtx.currentTime+0.8);g.gain.setValueAtTime(0.5,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.8);o.start();o.stop(audioCtx.currentTime+0.8);}
document.getElementById('soundToggle').onclick=()=>{soundOn=!soundOn;document.getElementById('soundToggle').textContent=soundOn?'🔊':'🔇';};
let keys={};addEventListener('keydown',e=>{keys[e.key]=true;});addEventListener('keyup',e=>{keys[e.key]=false;});
let bubbles=[],lightOffset=0;
for(let i=0;i<40;i++){bubbles.push({x:Math.random()*1000,y:Math.random()*700,r:0.5+Math.random()*3.5,spd:0.3+Math.random()*1.2,drift:Math.random()*0.8});}
function drawRealisticWater(){
let grad=ctx.createLinearGradient(0,0,0,H);
grad.addColorStop(0,'#87e8f5');grad.addColorStop(0.15,'#4dd0e1');grad.addColorStop(0.35,'#26a0b5');grad.addColorStop(0.65,'#0e6a7a');grad.addColorStop(1,'#083e47');
ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
ctx.save();ctx.globalAlpha=0.12;
for(let i=0;i<6;i++){
let x=W*0.15+i*W*0.16+Math.sin(lightOffset*0.001+i)*20;
let rayGrad=ctx.createLinearGradient(x,0,x+40,H*0.6);
rayGrad.addColorStop(0,'rgba(255,255,255,0.9)');rayGrad.addColorStop(1,'rgba(255,255,255,0)');
ctx.fillStyle=rayGrad;ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x+60,0);ctx.lineTo(x+90,H*0.7);ctx.lineTo(x-20,H*0.7);ctx.fill();
}
ctx.restore();
ctx.strokeStyle='rgba(255,255,255,0.25)';ctx.lineWidth=1.2;ctx.beginPath();
for(let x=0;x<W;x+=4){let y=12+Math.sin(x*0.02+lightOffset*0.01)*3+Math.sin(x*0.05)*1.5;if(x===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);}ctx.stroke();
ctx.strokeStyle='rgba(255,255,255,0.15)';ctx.lineWidth=1;ctx.beginPath();
for(let x=0;x<W;x+=5){let y=28+Math.sin(x*0.015+lightOffset*0.008)*4;if(x===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);}ctx.stroke();
bubbles.forEach(b=>{
b.y-=b.spd;b.x+=Math.sin(b.y*0.01)*b.drift*0.2;
if(b.y<0){b.y=H+10;b.x=Math.random()*W;}
ctx.fillStyle=`rgba(255,255,255,${0.15+b.r*0.05})`;ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,Math.PI*2);ctx.fill();
ctx.fillStyle='rgba(255,255,255,0.6)';ctx.beginPath();ctx.arc(b.x-b.r*0.3,b.y-b.r*0.3,b.r*0.35,0,Math.PI*2);ctx.fill();
});
ctx.globalAlpha=0.08;
for(let i=0;i<15;i++){
let cx=(W*0.5+Math.sin(lightOffset*0.002+i)*W*0.4)%W;
let cy=H*0.75+Math.cos(lightOffset*0.0015+i*0.7)*60;
ctx.fillStyle='rgba(255,255,200,0.9)';ctx.beginPath();ctx.ellipse(cx,cy,20+Math.sin(i)*10,8+Math.cos(i)*4,Math.sin(i),0,Math.PI*2);ctx.fill();
}
ctx.globalAlpha=1;lightOffset+=1.2;
}
class RealisticDuck{
constructor(num){
this.num=num;this.beakColor=['#e67e22','#d35400','#e74c3c','#c0392b','#2c3e50'][Math.floor(Math.random()*5)];
this.visited=false;this.blink=Math.random()*6;this.colorFlashTime=0;this.randomColor='#fff';
this.eating=false;this.eatProgress=0;this.wingFlap=0;this.reset();
}
reset(){
this.x=(Math.random()>0.5?W+120:-120);this.y=50+Math.random()*(H-150);
this.vx=(Math.random()>0.5?1:-1)*(0.5+Math.random()*1.2);this.vy=(Math.random()-0.5)*0.4;this.size=20+Math.random()*12;
}
update(dt){
if(!this.eating){this.x+=this.vx;this.y+=this.vy;if(this.y<42||this.y>H-60)this.vy*=-1;if(this.x<-150||this.x>W+150){this.x=this.vx>0?-120:W+120;}}
this.blink+=0.10;if(this.colorFlashTime>0)this.colorFlashTime-=dt;this.wingFlap+=0.18;
if(this.eating){this.eatProgress+=dt;if(this.eatProgress>800)this.eatProgress=800;}
}
startEating(){this.eating=true;this.eatProgress=0;}
draw(){
ctx.save();ctx.translate(this.x,this.y);ctx.scale(this.vx>0?1:-1,1);
let bodyCol='#ffffff';if(this.colorFlashTime>0)bodyCol=this.randomColor;if(this.eating)bodyCol='#fef9e7';
ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,this.size*0.75,this.size*0.9,this.size*0.22,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle=bodyCol;ctx.beginPath();ctx.ellipse(0,2,this.size*0.95,this.size*0.62,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle=this.eating?'#fdebd0':(this.colorFlashTime>0?this.randomColor:'#fdfefe');ctx.globalAlpha=0.9;
ctx.beginPath();ctx.ellipse(-2,0,this.size*0.75,this.size*0.5,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
ctx.strokeStyle='rgba(0,0,0,0.08)';ctx.lineWidth=0.6;
for(let i=-2;i<=2;i++){ctx.beginPath();ctx.moveTo(-this.size*0.6,i*3);ctx.quadraticCurveTo(0,i*3+1,this.size*0.6,i*3);ctx.stroke();}
let wingY=Math.sin(this.wingFlap)*1.5;
ctx.fillStyle=bodyCol==='#ffffff'?'#f2f3f4':bodyCol;ctx.beginPath();ctx.ellipse(-2,wingY,this.size*0.5,this.size*0.28,-0.2,0,Math.PI*2);ctx.fill();
ctx.strokeStyle='rgba(0,0,0,0.1)';ctx.lineWidth=0.5;ctx.beginPath();ctx.ellipse(-2,wingY,this.size*0.5,this.size*0.28,-0.2,0,Math.PI*2);ctx.stroke();
ctx.fillStyle=bodyCol;ctx.beginPath();ctx.ellipse(this.size*0.72,-2,this.size*0.48,this.size*0.42,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle=this.beakColor;
let beakOpen=this.eating?Math.min(this.eatProgress/200,1)*8:0;
ctx.beginPath();
if(this.eating){ctx.moveTo(this.size*1.0,-4);ctx.lineTo(this.size*1.55,-8-beakOpen);ctx.lineTo(this.size*1.55,2+beakOpen);ctx.lineTo(this.size*1.0,2);ctx.fill();ctx.fillStyle='#b03a2e';ctx.beginPath();ctx.ellipse(this.size*1.3,0,4,6+beakOpen,0,0,Math.PI*2);ctx.fill();}
else{ctx.ellipse(this.size*1.14,-1,this.size*0.42,this.size*0.20,0,0,Math.PI*2);ctx.fill();}
ctx.fillStyle='rgba(0,0,0,0.5)';ctx.beginPath();ctx.arc(this.size*1.05,-3,0.8,0,Math.PI*2);ctx.fill();
ctx.restore();
ctx.save();ctx.translate(this.x,this.y);
let a=0.70+0.30*Math.sin(this.blink);if(this.visited)a=0.22;
ctx.globalAlpha=a;ctx.fillStyle=this.visited?'#888':'#7d0a0a';ctx.font=`bold ${this.size*0.62}px Poppins`;ctx.textAlign='center';ctx.textBaseline='middle';
ctx.strokeStyle='white';ctx.lineWidth=2;ctx.strokeText(this.num,0,1);ctx.fillText(this.num,0,1);ctx.globalAlpha=1;ctx.restore();
ctx.save();ctx.translate(this.x,this.y);ctx.scale(this.vx>0?1:-1,1);
ctx.fillStyle='white';ctx.beginPath();ctx.ellipse(this.size*0.82,-6,4.2,4.5,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle='#1a1a1a';ctx.beginPath();ctx.arc(this.size*0.86,-6,2.8,0,Math.PI*2);ctx.fill();
ctx.fillStyle='black';ctx.beginPath();ctx.arc(this.size*0.90,-6,1.6,0,Math.PI*2);ctx.fill();
ctx.fillStyle='white';ctx.beginPath();ctx.arc(this.size*0.92,-7.5,1,0,Math.PI*2);ctx.fill();
ctx.restore();
}
flashRandomColor(){this.colorFlashTime=1000;let c=['#ff9a9e','#fad0c4','#a1c4fd','#ffecd2','#fcb69f'];this.randomColor=c[Math.floor(Math.random()*c.length)];}
}
class RealisticAquariumFish{
constructor(){this.x=W*0.08;this.y=H/2;this.size=24;this.speed=3.6;this.vx=0;this.vy=0;this.colorFlashTime=0;this.baseHue=Math.random()*360;this.accentHue=(this.baseHue+65)%360;this.thirdHue=(this.baseHue+180)%360;this.autoChangeTimer=0;this.bob=0;this.eaten=false;this.eatX=0;this.eatY=0;}
update(){if(this.eaten){this.x+=(this.eatX-this.x)*0.15;this.y+=(this.eatY-this.y)*0.15;this.size*=0.98;return;}let dx=0,dy=0;if(keys['ArrowUp']||keys['w'])dy=-1;if(keys['ArrowDown']||keys['s'])dy=1;if(keys['ArrowLeft']||keys['a'])dx=-1;if(keys['ArrowRight']||keys['d'])dx=1;if(dx||dy){let m=Math.hypot(dx,dy);dx/=m;dy/=m;}this.vx=dx*this.speed;this.vy=dy*this.speed;this.x+=this.vx;this.y+=this.vy;this.x=Math.max(this.size,Math.min(W-this.size,this.x));this.y=Math.max(45,Math.min(H-this.size-10,this.y));if(this.colorFlashTime>0)this.colorFlashTime-=16;this.bob+=0.08;this.autoChangeTimer+=16;if(this.autoChangeTimer>3000){this.autoChangeTimer=0;this.baseHue=(this.baseHue+20+Math.random()*80)%360;this.accentHue=(this.baseHue+50+Math.random()*80)%360;this.thirdHue=(this.accentHue+100+Math.random()*80)%360;}}
flashRandomColor(){this.colorFlashTime=1200;this.baseHue=Math.random()*360;this.accentHue=(this.baseHue+60+Math.random()*80)%360;this.thirdHue=(this.accentHue+120+Math.random()*60)%360;this.autoChangeTimer=0;}
startEaten(duckX,duckY){this.eaten=true;this.eatX=duckX+12;this.eatY=duckY-1;}
draw(s){if(this.size<2)return;ctx.save();ctx.translate(this.x,this.y);let ang=Math.atan2(this.vy,this.vx);if(!this.eaten&&(Math.abs(this.vx)>0.1||Math.abs(this.vy)>0.1))ctx.rotate(ang);if(s&&!this.eaten){ctx.shadowColor='#00ffcc';ctx.shadowBlur=24;ctx.strokeStyle='rgba(0,255,200,0.95)';ctx.lineWidth=3.5;ctx.beginPath();ctx.arc(0,0,this.size*2.2,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;}let bg=ctx.createRadialGradient(-5,-4,2,0,0,this.size*1.5);bg.addColorStop(0,`hsl(${this.baseHue},100%,78%)`);bg.addColorStop(0.5,`hsl(${this.accentHue},90%,60%)`);bg.addColorStop(1,`hsl(${this.baseHue},70%,35%)`);ctx.fillStyle=bg;ctx.beginPath();ctx.ellipse(0,0,this.size*1.55,this.size*0.92,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='rgba(255,255,255,0.18)';for(let r=-2;r<=2;r++){for(let c=-3;c<=3;c++){let sx=c*7+(r%2)*3.5;let sy=r*5;if(sx*sx/(this.size*1.2*this.size*1.2)+sy*sy/(this.size*0.8*this.size*0.8)<1){ctx.beginPath();ctx.arc(sx,sy,2.2,0,Math.PI*2);ctx.fill();}}}ctx.fillStyle=`hsla(${this.accentHue},85%,60%,0.85)`;ctx.beginPath();ctx.moveTo(-2,-this.size*0.82);ctx.quadraticCurveTo(4,-this.size*1.5,10,-this.size*0.7);ctx.quadraticCurveTo(2,-this.size*0.6,-2,-this.size*0.82);ctx.fill();ctx.fillStyle=`hsl(${this.baseHue},85%,60%)`;ctx.beginPath();ctx.moveTo(-this.size*1.3,0);ctx.bezierCurveTo(-this.size*1.8,-this.size*0.2,-this.size*2.4,-this.size*1.0,-this.size*2.2,-this.size*0.15);ctx.bezierCurveTo(-this.size*1.9,0,-this.size*2.2,this.size*0.15,-this.size*2.4,this.size*1.0);ctx.bezierCurveTo(-this.size*1.8,this.size*0.2,-this.size*1.3,0,-this.size*1.3,0);ctx.fill();ctx.fillStyle='white';ctx.beginPath();ctx.arc(this.size*0.78,-5.5,7.5,0,Math.PI*2);ctx.fill();ctx.fillStyle='black';ctx.beginPath();ctx.arc(this.size*0.9,-5.5,2,0,Math.PI*2);ctx.fill();if(this.colorFlashTime>0){let it=this.colorFlashTime/1200;ctx.shadowColor=`hsl(${this.baseHue},100%,60%)`;ctx.shadowBlur=20*it;ctx.strokeStyle=`hsla(${this.baseHue},100%,70%,${it})`;ctx.lineWidth=2.5*it;ctx.beginPath();ctx.ellipse(0,0,this.size*1.65,this.size*1.02,0,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;}ctx.restore();}
}
class RealisticSmallFish{
constructor(){this.x=W*0.88;this.y=H*0.5;this.size=14;this.vx=(Math.random()-0.5)*2.2;this.vy=(Math.random()-0.5)*1.8;this.bob=0;this.baseHue=Math.random()*360;this.accentHue=(this.baseHue+70)%360;this.variety=0;this.changeTimer=0;this.crocCycle=0;this.isCrocodile=false;}
update(dt){this.bob+=0.07;this.x+=this.vx;this.y+=this.vy+Math.sin(this.bob)*0.5;if(this.x<W*0.6||this.x>W-30){this.vx*=-1;this.x=Math.max(W*0.6,Math.min(W-30,this.x));}if(this.y<50||this.y>H-50){this.vy*=-1;}this.changeTimer+=dt;if(this.changeTimer>2000&&!this.isCrocodile){this.changeTimer=0;this.baseHue=(this.baseHue+30+Math.random()*120)%360;this.accentHue=(this.baseHue+60+Math.random()*90)%360;this.variety=(this.variety+1)%3;}this.crocCycle+=dt;if(this.crocCycle>10000){this.crocCycle=0;}let wasCroc=this.isCrocodile;this.isCrocodile=this.crocCycle>9000;if(this.isCrocodile&&!wasCroc){playCroc();document.getElementById('crocWarning').classList.remove('hidden');}if(!this.isCrocodile&&wasCroc){document.getElementById('crocWarning').classList.add('hidden');}}
draw(){ctx.save();ctx.translate(this.x,this.y);let ang=Math.atan2(this.vy,this.vx);ctx.rotate(ang);
if(this.isCrocodile){
ctx.fillStyle='#1e3d0f';ctx.beginPath();ctx.ellipse(0,0,36,20,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle='#2d5a1a';ctx.beginPath();ctx.ellipse(2,0,32,16,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle='rgba(0,0,0,0.2)';for(let i=-2;i<=2;i++){for(let j=-1;j<=1;j++){ctx.beginPath();ctx.ellipse(i*8,j*6,3,2,0,0,Math.PI*2);ctx.fill();}}
ctx.fillStyle='#1e3d0f';ctx.beginPath();ctx.moveTo(12,-14);ctx.lineTo(36,-18);ctx.lineTo(36,18);ctx.lineTo(12,14);ctx.fill();
ctx.fillStyle='#2d5a1a';ctx.beginPath();ctx.moveTo(12,-12);ctx.lineTo(38,-20);ctx.quadraticCurveTo(42,-10,38,-2);ctx.lineTo(12,-2);ctx.fill();
ctx.beginPath();ctx.moveTo(12,2);ctx.lineTo(38,2);ctx.quadraticCurveTo(42,10,38,20);ctx.lineTo(12,12);ctx.fill();
ctx.fillStyle='#0a0a0a';ctx.beginPath();ctx.ellipse(24,0,16,14,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle='#8b0000';ctx.beginPath();ctx.ellipse(28,6,8,5,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle='#f5f5dc';for(let i=-2;i<=3;i++){let tx=16+i*4;ctx.beginPath();ctx.moveTo(tx,-10);ctx.lineTo(tx+1,-18);ctx.lineTo(tx+2.5,-10);ctx.fill();ctx.beginPath();ctx.moveTo(tx,10);ctx.lineTo(tx+1,18);ctx.lineTo(tx+2.5,10);ctx.fill();}
ctx.fillStyle='#ffcc00';ctx.beginPath();ctx.ellipse(-6,-12,7,6,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='black';ctx.beginPath();ctx.ellipse(-5,-12,4,3.5,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle='#0f2a05';for(let i=-2;i<=2;i++){ctx.beginPath();ctx.moveTo(i*10-4,-16);ctx.lineTo(i*10,-24);ctx.lineTo(i*10+4,-16);ctx.fill();}
ctx.shadowColor='red';ctx.shadowBlur=24;ctx.strokeStyle='rgba(255,0,0,0.7)';ctx.lineWidth=2.5;ctx.beginPath();ctx.arc(0,0,42,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;
}else{
ctx.shadowColor=`hsl(${this.baseHue},90%,60%)`;ctx.shadowBlur=14;
let grad=ctx.createLinearGradient(-this.size,-this.size/2,this.size,this.size/2);
grad.addColorStop(0,`hsl(${this.baseHue},92%,68%)`);grad.addColorStop(1,`hsl(${this.accentHue},88%,58%)`);
ctx.fillStyle=grad;ctx.beginPath();ctx.ellipse(0,0,this.size*1.3,this.size*0.78,0,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
ctx.fillStyle='rgba(255,255,255,0.22)';for(let i=-1;i<=1;i++){ctx.beginPath();ctx.arc(i*4,0,1.8,0,Math.PI*2);ctx.fill();}
ctx.fillStyle=`hsl(${this.baseHue},85%,55%)`;ctx.beginPath();ctx.moveTo(-this.size*1.1,0);ctx.lineTo(-this.size*1.8,-this.size*0.6);ctx.lineTo(-this.size*1.8,this.size*0.6);ctx.closePath();ctx.fill();
ctx.fillStyle='white';ctx.beginPath();ctx.arc(this.size*0.5,-3,4.2,0,Math.PI*2);ctx.fill();ctx.fillStyle=`hsl(${this.baseHue},60%,30%)`;ctx.beginPath();ctx.arc(this.size*0.62,-3,2.5,0,Math.PI*2);ctx.fill();
}
ctx.restore();}
}
let allDucks=[],activeDucks=[],fish,prey,score,gameState,shieldTime,crossedSet;let lastCrossTime=0;const MAX_VISIBLE=32;const COOLDOWN=500;
let eatingDuck=null;let eatAnimTime=0;
function init(){
allDucks=[];for(let i=1;i<=100;i++)allDucks.push(new RealisticDuck(i));
activeDucks=[];let sh=[...allDucks].sort(()=>0.5-Math.random());for(let i=0;i<MAX_VISIBLE;i++)activeDucks.push(sh[i]);
fish=new RealisticAquariumFish();prey=new RealisticSmallFish();score=0;gameState='playing';shieldTime=3000;crossedSet=new Set();lastCrossTime=0;eatingDuck=null;eatAnimTime=0;
document.getElementById('score').textContent=score;document.getElementById('target').textContent='छोटी Aquarium';document.getElementById('status').textContent='जिंदा';
document.getElementById('shieldBar').classList.remove('hidden');document.getElementById('cooldownBar').classList.add('hidden');document.getElementById('crocWarning').classList.add('hidden');
}
let lastTime=0;
function loop(t){
if(gameState!=='eating'&&gameState!=='playing')return;
let delta=t-lastTime;lastTime=t;
if(gameState==='eating'){
eatAnimTime+=delta;drawRealisticWater();prey.update(delta);prey.draw();activeDucks.forEach(d=>{d.update(delta);d.draw();});fish.update();fish.draw(false);
if(eatAnimTime>900){finalGameOver(false,`🦆 नंबर ${eatingDuck.num} वाली बत्तख ने आपकी Fish को खा लिया! Fish बत्तख के मुंह में चली गई!`,false);return;}
requestAnimationFrame(loop);return;
}
if(shieldTime>0){shieldTime-=delta;if(shieldTime<=0){document.getElementById('shieldBar').classList.add('hidden');shieldTime=0;}else{document.getElementById('shieldBar').textContent=`🛡️ सुरक्षा: ${Math.ceil(shieldTime/1000)}s`;}}
let since=t-lastCrossTime;if(since<COOLDOWN&&lastCrossTime!==0){document.getElementById('cooldownBar').classList.remove('hidden');}else{document.getElementById('cooldownBar').classList.add('hidden');}
drawRealisticWater();prey.update(delta);prey.draw();
let isShield=shieldTime>0;fish.update();fish.draw(isShield);activeDucks.forEach(d=>{d.update(delta);d.draw();});
if(Math.random()<0.03){let remaining=allDucks.filter(d=>!activeDucks.includes(d)&&!d.visited);if(remaining.length>0){let idx=activeDucks.findIndex(d=>d.visited&&d.colorFlashTime<=0);if(idx!==-1){let nd=remaining[Math.floor(Math.random()*remaining.length)];nd.reset();activeDucks[idx]=nd;}}}
activeDucks.forEach(d=>{
let dist=Math.hypot(fish.x-d.x,fish.y-d.y);
if(!isShield&&dist<d.size*0.9+fish.size*0.7){
if(gameState==='playing'){gameState='eating';eatingDuck=d;d.startEating();fish.startEaten(d.x,d.y);playDuk(true);eatAnimTime=0;}
return;
}
let fishLR=Math.abs(fish.vx)>0.8&&Math.abs(fish.vx)>Math.abs(fish.vy)*1.2;let opposite=(d.vx*fish.vx<-0.2);let cd=(t-lastCrossTime)>COOLDOWN;
if(fishLR&&!d.visited&&dist>35&&dist<100&&opposite&&cd){d.visited=true;d.flashRandomColor();fish.flashRandomColor();crossedSet.add(d.num);score=crossedSet.size;document.getElementById('score').textContent=score;lastCrossTime=t;playPoint();if(score>=100)document.getElementById('target').textContent='अब छोटी Aquarium खाओ!';}
});
if(score>=100){let dp=Math.hypot(fish.x-prey.x,fish.y-prey.y);if(!prey.isCrocodile&&dp<40)finalGameOver(true,"🌈 जीत गए! 100 बत्तख + छोटी Aquarium!");else if(prey.isCrocodile&&dp<45){finalGameOver(false,`🐊 मगरमच्छ ने Fish को खा लिया! Small Fish जीती!`,true);}}else{if(prey.isCrocodile){let dp=Math.hypot(fish.x-prey.x,fish.y-prey.y);if(dp<44){finalGameOver(false,`🐊 छोटी Fish मगरमच्छ बन गई थी और उसने आपकी Fish को खा लिया!`,true);}}}
requestAnimationFrame(loop);
}
function finalGameOver(win,msg,isCroc=false){
if(gameState!=='playing'&&gameState!=='eating')return;gameState=win?'won':'lost';
document.getElementById('status').textContent=win?'जीते':'हारे';
document.getElementById('shieldBar').classList.add('hidden');document.getElementById('cooldownBar').classList.add('hidden');document.getElementById('crocWarning').classList.add('hidden');
const ov=document.getElementById('overlay');ov.classList.remove('hidden');
if(isCroc){ov.innerHTML=`<h1>🐊 मगरमच्छ जीत गया! 🐊</h1><p>${msg}<br><br>स्कोर: ${score}/100</p><button onclick="restart()">फिर से खेलो</button>`;}else{ov.innerHTML=`<h1>${win?'🏆 जीत गए!':'💀 Game Over'}</h1><p>${msg}<br><br>स्कोर: ${score}/100</p><button onclick="restart()">फिर से खेलो</button>`;}
}
function restart(){document.getElementById('overlay').classList.add('hidden');init();requestAnimationFrame(loop);}
document.getElementById('startBtn').onclick=()=>{initAudio();playDuk(false);document.getElementById('overlay').classList.add('hidden');init();requestAnimationFrame(loop);};
init();requestAnimationFrame(loop);
</script>
