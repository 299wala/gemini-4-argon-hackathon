<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@700;800&display=swap');
body{margin:0;background:#0a3d62;font-family:'Poppins',sans-serif;overflow:hidden;display:flex;justify-content:center;align-items:center;height:100vh}
